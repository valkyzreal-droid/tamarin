<Window x:Class="Tamarin.App.Views.ConfirmDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        SizeToContent="Height" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="{DynamicResource Inset.24}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" IsDefault="True" MinWidth="88" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
