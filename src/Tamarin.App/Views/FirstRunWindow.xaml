<Window x:Class="Tamarin.App.Views.FirstRunWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Tamarin.App.Controls"
        Style="{StaticResource WindowBase}"
        SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="{DynamicResource Inset.24}">
        <TextBlock x:Name="Heading" FontSize="{DynamicResource FontSize.Lg}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Body" Margin="0,12,0,0" TextWrapping="Wrap" />
        <ctl:KeyCaps x:Name="KeyText" Margin="0,18,0,0" HorizontalAlignment="Left" />
        <TextBlock x:Name="TrayText" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="ChangeButton" Margin="0,0,8,0" Click="OnChange" />
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnStart" />
        </StackPanel>
    </StackPanel>
</Window>
