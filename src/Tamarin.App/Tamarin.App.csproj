<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) and Screen: both ship with .NET, no extra package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Off on purpose: WPF and WinForms both define Application, Button, Clipboard, KeyEventArgs...
         so every using in this project is written out instead of implied. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tamarin</AssemblyName>
    <RootNamespace>Tamarin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tamarin.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets the project be restored and inspected on non-Windows machines (CI, editors). -->
    <!-- WFAC010 asks for WinForms-style DPI setup; this is a WPF app and the manifest is the right place for it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Quick-capture notepad: one hotkey, type, close. Saved and searchable.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inter (SIL Open Font License, see Assets/Fonts/OFL-Inter.txt), embedded so the look is the same on every PC. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamarin.Core\Tamarin.Core.csproj" />
  </ItemGroup>

</Project>
